# Copiez ce fichier en .env et remplissez les valeurs

# Secret pour signer les sessions (mettez une longue chaine aleatoire en production)
JWT_SECRET=change-me-to-a-long-random-string

# Cle pour declencher manuellement /api/admin/run-sweep (tests)
ADMIN_KEY=change-me-too

# Envoi d'email : cas simple = un compte Gmail avec un "mot de passe d'application"
# (Compte Google > Securite > Validation en 2 etapes > Mots de passe des applications)
# Ce n'est PAS votre mot de passe Gmail habituel, c'est un mot de passe dedie genere par Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=votre-mot-de-passe-application

PORT=4000
