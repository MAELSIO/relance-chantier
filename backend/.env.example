# Copiez ce fichier en .env et remplissez les valeurs

# Secret pour signer les sessions (mettez une longue chaine aleatoire en production)
JWT_SECRET=change-me-to-a-long-random-string

# Cle pour declencher manuellement /api/admin/run-sweep (tests)
ADMIN_KEY=change-me-too

# Envoi d'email via l'API HTTPS de Resend (resend.com, gratuit jusqu'a 3000
# emails/mois). Necessaire car les hebergeurs gratuits type Render bloquent
# le SMTP sortant. Creez un compte, recuperez une cle API sur resend.com/api-keys.
RESEND_API_KEY=re_...
# Tant que votre domaine n'est pas verifie sur Resend, cet expediteur par defaut
# ne peut envoyer qu'a l'adresse email de votre propre compte Resend.
RESEND_FROM=Relance Chantier <onboarding@resend.dev>
# Optionnel : adresse a laquelle les reponses des clients doivent arriver.
RESEND_REPLY_TO=

# Stripe (mode test d'abord : cles qui commencent par sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
# Genere par Stripe CLI ou par le tableau de bord Stripe (section Webhooks) une fois
# l'URL /api/billing/webhook enregistree comme destination.
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=4000
